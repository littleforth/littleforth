{
  "comments": { "lineComment": "\\", "blockComment": ["( ", " )"] },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [{ "open": "(", "close": ")", "notIn": ["string"] }, { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }],
  "wordPattern": "[^\\s]+",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*:\\s+\\S+(?!.*\\s;\\s*(\\\\.*)?$)",
    "decreaseIndentPattern": "^\\s*;"
  }
}
